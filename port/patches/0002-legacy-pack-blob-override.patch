 #endif
@@ -736,6 +922,8 @@ uint32_t CCALL RecordGetSize(int32_t RecordHandle)
     RecordInfo *Record = &(RecordBuffer[RecordHandle]);
     result = 0;
 
+    if (Record->PackFile != NULL) return Record->PackSize;
+
 #ifdef _WIN32
     EnterCriticalSection(&CriticalSection);
 #else
